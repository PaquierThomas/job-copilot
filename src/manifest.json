{
  "description": "Adds a browser action icon to the toolbar. Click the button to show a popup.",
  "manifest_version": 3,
  "name": "job-copilot",
  "version": "1.0",
  "icons": {
    "48": "icons/claude-color.jpg"
  },

  "permissions": ["activeTab", "scripting", "storage"],

  "browser_specific_settings": {
    "gecko": {
      "id": "job-copilot@thomas.dev",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "background": {
    "scripts": ["background/background.js"]
  },

  "sidebar_action": {
    "default_icon": "icons/claude-color.jpg",
    "default_title": "job-copilot",
    "default_panel": "sidebar/sidebar.html"
  },
  "action": {
    "default_icon": "icons/claude-color.jpg",
    "default_title": "job-copilot"
  }
}
